# ── Blockchain (Sepolia / Local) ──────────────────────────────────
# Get your free Alchemy URL from https://alchemy.com
# Select: Chain = Ethereum, Network = Ethereum Sepolia
BLOCKCHAIN_RPC_URL="https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY"

# Deployed contract address — copy from deploy.js output after running:
# npx hardhat run scripts/deploy.js --network sepolia
CONTRACT_ADDRESS="0xYOUR_DEPLOYED_CONTRACT_ADDRESS"

# Your MetaMask wallet private key (the beekeeper/admin account)
# Get from MetaMask → Account Details → Show Private Key
PRIVATE_KEY="YOUR_METAMASK_PRIVATE_KEY"

# ── For local testing only (comment out when using Sepolia) ───────
# BLOCKCHAIN_RPC_URL="http://127.0.0.1:8545"
# CONTRACT_ADDRESS="0x5FbDB2315678afecb367f032d93F642f64180aa3"
